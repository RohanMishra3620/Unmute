# Optional LLM. Leave key/model empty to run on the built-in rule-based fallback.
LLM_PROVIDER=openai          # "openai" (any OpenAI-compatible API) or "anthropic"
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=12

SESSION_SECONDS=300
PORT=5000

# Crisis information is configurable per country: "Label:number;Label:number"
EMERGENCY_CONTACTS=Emergency services:112;Tele-MANAS (India):14416
EMERGENCY_MESSAGE=
